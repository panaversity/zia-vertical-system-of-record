{
  "name": "@vsor/sor-site-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The vsor runtime site shell — the Docusaurus site that vsor build and vsor dev unpack over a project's .vsor/site-runtime. Generated and disposable, never edited in place: it builds from copies of the project's corpus and site config that are refreshed on every invoke.",
